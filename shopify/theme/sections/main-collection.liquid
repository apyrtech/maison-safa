<div class="wrap" style="padding-top:2.5rem;">
  <p class="label">The house</p>
  <h1 class="page-title" style="margin-top:0.5rem;">
    {% if collection.handle == 'all' %}Shop{% else %}{{ collection.title }}{% endif %}
  </h1>
  {% if collection.description != blank %}
    <p class="muted" style="max-width:36rem;margin-top:1rem;">{{ collection.description }}</p>
  {% endif %}

  <div class="toolbar">
    <nav class="chips" aria-label="Categories">
      <a class="chip" href="{{ routes.all_products_collection_url }}" {% if collection.handle == 'all' %}aria-current="page"{% endif %}>All</a>
      <a class="chip" href="/collections/thobes" {% if collection.handle == 'thobes' %}aria-current="page"{% endif %}>Thobes</a>
      <a class="chip" href="/collections/abayas" {% if collection.handle == 'abayas' %}aria-current="page"{% endif %}>Abayas</a>
      <a class="chip" href="/collections/koofis" {% if collection.handle == 'koofis' %}aria-current="page"{% endif %}>Koofis</a>
    </nav>
    <form class="sort" method="get">
      <label class="label" for="SortBy">Sort</label>
      <select id="SortBy" name="sort_by" onchange="this.form.submit()">
        {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
        {% for option in collection.sort_options %}
          <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
        {% endfor %}
      </select>
    </form>
  </div>

  {% paginate collection.products by 24 %}
    {% if collection.products.size == 0 %}
      <p class="empty">Nothing in this collection yet. Import the catalog, then check the collection handle is thobes, abayas, or koofis.</p>
    {% else %}
      <div class="product-grid">
        {% for product in collection.products %}
          {% render 'card', product: product, handle: product.handle %}
        {% endfor %}
      </div>
    {% endif %}
    {% if paginate.pages > 1 %}
      <nav class="toolbar" aria-label="Pagination" style="margin-top:2.5rem;">
        {% if paginate.previous %}<a class="quiet-link" href="{{ paginate.previous.url }}">Previous</a>{% endif %}
        <span class="muted">{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {% if paginate.next %}<a class="quiet-link" href="{{ paginate.next.url }}">Next</a>{% endif %}
      </nav>
    {% endif %}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
