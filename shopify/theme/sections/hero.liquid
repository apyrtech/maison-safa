<section class="wrap hero">
  <div class="hero-copy">
    <p class="label">{{ section.settings.eyebrow }}</p>
    <h1 class="display">{{ section.settings.heading | newline_to_br }}</h1>
    <p>{{ section.settings.copy }}</p>
    <div class="hero-actions">
      <a class="btn btn-ink" href="{{ routes.all_products_collection_url }}">{{ section.settings.primary }}</a>
      <a class="btn btn-line" href="/pages/atelier">{{ section.settings.secondary }}</a>
    </div>
  </div>
  <div class="hero-media portrait">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: alt: section.settings.image_alt, class: 'cover', widths: '600, 900, 1400', sizes: '(min-width: 1024px) 50vw, 100vw' }}
    {% else %}
      <img src="{{ 'hero.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1200" height="1600" class="cover">
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Autumn 2026" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "The thobe.\nThe abaya.\nThe koofi." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "Maison Safa is a small house for these three. Cloth we can name. Seams you can trust. Cut to order in Riyadh, finished to the same pattern in London." },
    { "type": "text", "id": "primary", "label": "Primary button", "default": "Shop the house" },
    { "type": "text", "id": "secondary", "label": "Secondary button", "default": "The atelier" },
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "text", "id": "image_alt", "label": "Photograph description", "default": "An ivory thobe, a black abaya, and a cream koofi in the atelier." }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
