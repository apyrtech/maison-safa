<section aria-label="House practice">
  <ul class="facts">
    {% for block in section.blocks %}
      <li {{ block.shopify_attributes }}>
        <p class="label">{{ block.settings.label }}</p>
        <h2>{{ block.settings.text }}</h2>
      </li>
    {% endfor %}
  </ul>
</section>

{% schema %}
{
  "name": "House practice",
  "blocks": [
    {
      "type": "fact",
      "name": "Note",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Cloth" },
        { "type": "text", "id": "text", "label": "Text", "default": "Named mills. Cotton, crepe, wool, linen." }
      ]
    }
  ],
  "presets": [
    {
      "name": "House practice",
      "blocks": [
        { "type": "fact", "settings": { "label": "Cloth", "text": "Named mills. Cotton, crepe, wool, linen." } },
        { "type": "fact", "settings": { "label": "Cut", "text": "Numbered sizes, tried on a standing form." } },
        { "type": "fact", "settings": { "label": "Time", "text": "Two to three weeks, cut to order." } },
        { "type": "fact", "settings": { "label": "Repair", "text": "Seams and cuffs, for the life of the cloth." } }
      ]
    }
  ]
}
{% endschema %}
