<div class="wrap page cart-page">
  <h1 class="page-title">Bag</h1>
  {% if cart.item_count == 0 %}
    <p class="empty">The bag is empty.</p>
    <a class="btn btn-line" href="{{ routes.all_products_collection_url }}">Shop the house</a>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" style="margin-top:2rem;">
      {% for item in cart.items %}
        <article class="line">
          <div class="portrait">
            {% if item.image %}
              <img src="{{ item.image | image_url: width: 300 }}" alt="" class="cover">
            {% endif %}
          </div>
          <div>
            <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
            <p class="card-meta">{{ item.variant.title }}</p>
            <label class="card-meta" for="Updates-{{ forloop.index }}">Quantity</label>
            <input id="Updates-{{ forloop.index }}" class="sort" style="width:4rem;border:0;border-bottom:1px solid var(--line);background:transparent;" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
          </div>
          <p>{{ item.final_line_price | money }}</p>
        </article>
      {% endfor %}
      <div class="totals" style="margin-top:1.5rem;">
        <span>Subtotal</span>
        <span>{{ cart.total_price | money }}</span>
      </div>
      <div style="display:flex;gap:0.75rem;flex-wrap:wrap;margin-top:1rem;">
        <button class="btn btn-line" type="submit" name="update">Update</button>
        <button class="btn btn-ink" type="submit" name="checkout">Checkout</button>
      </div>
    </form>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
